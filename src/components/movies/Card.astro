---
import "@/styles/global.css";

interface Props {
    title: string;
    duration: number;
    imageSrc?: string;
    imageAlt?: string;
}

const { title, duration, imageSrc, imageAlt } = Astro.props;
---

<div class="movie-card">
    <img class="background" src={imageSrc} alt={imageAlt} />
    <div class="gradient-overlay"></div>
    <div class="info">
        <h2>{title}</h2>
        <p>Duration {duration}min</p>
    </div>
</div>

<style>
    .movie-card {
        position: relative;
        overflow: hidden;

        padding-left: 1rem;
        align-content: end;
        font-family: sans-serif;
        color: whitesmoke;

        aspect-ratio: 2/3;
        transition: scale 250ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .movie-card:hover {
        cursor: pointer;
        scale: 1.025;
        outline: 0.25rem solid var(--main-color);
    }

    .background {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
    }

    .gradient-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.8) 0%,
            rgba(0, 0, 0, 0) 60%
        );
        z-index: 2;
    }

    .info {
        position: relative;
        z-index: 3;
    }
</style>
