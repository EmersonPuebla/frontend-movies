---
import Layout from "@/layouts/Layout.astro";
import { getAccessToken } from "@/lib/session";
import { deleteMovie, fetchMovieBySlug, type Movie } from "@/lib/api";
import { resolveImageUrl } from "@/lib/media";

const { slug } = Astro.params;
const accessToken = getAccessToken(Astro.request.headers.get("cookie")) ?? "";

let movie: Movie | undefined;
let errorMessage: string | null = null;

try {
    movie = await fetchMovieBySlug(accessToken, slug ?? "");
    if (!movie) errorMessage = "Película no encontrada";
} catch (error) {
    errorMessage =
        error instanceof Error ? error.message : "Error al cargar la película";
}

if (Astro.request.method === "POST" && movie) {
    try {
        await deleteMovie(accessToken, movie.id);
        return Astro.redirect("/movies");
    } catch (error) {
        errorMessage =
            error instanceof Error
                ? error.message
                : "Error al eliminar la película";
    }
}

function formatDate(value: string): string {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day).toLocaleDateString("es-ES", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<Layout title={movie ? movie.title : "Película"}>
    <main class="page">
        <a class="back" href="/movies">
            ← Volver
        </a>

        {errorMessage || !movie ? (
            <p class="message" role="alert">
                {errorMessage ?? "Película no encontrada"}
            </p>
        ) : (
            <>
                <h1>{movie.title}</h1>
                <div class="movie-details">
                    <div class="poster">
                        <img
                            src={resolveImageUrl(movie.image_src)}
                            alt={`Carátula de ${movie.title}`}
                            transition:name={movie.slug}
                        />
                    </div>
                    <div>
                        <p class="synopsis">{movie.synopsis}</p>

                        <div class="info-block">
                            <strong>Fecha de estreno</strong>
                            <p>{formatDate(movie.release_date)}</p>
                        </div>

                        <div class="info-block">
                            <strong>Duración</strong>
                            <p>{movie.duration} minutos</p>
                        </div>

                        <div class="info-block">
                            <strong>Director</strong>
                            <p>{movie.director}</p>
                        </div>
                    </div>
                </div>

                <div class="actions">
                    <a class="edit" href={`/movies/${movie.slug}/edit`}>
                        Editar
                    </a>
                    <form
                        method="POST"
                        data-astro-reload
                        onsubmit="return confirm('¿Seguro que quieres eliminar esta película?')"
                    >
                        <button type="submit" class="delete">
                            Eliminar
                        </button>
                    </form>
                </div>
            </>
        )}
    </main>
</Layout>

<style>
    .page {
        max-width: 800px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .back {
        display: inline-block;
        margin-bottom: 1rem;
        text-decoration: none;
        color: #000;
        background: var(--main-color);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        font-weight: 600;
    }

    h1 {
        margin: 0 0 1.5rem;
        line-height: 1.2;
    }

    .movie-details {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 2rem;
        align-items: start;
    }

    .poster img {
        display: block;
        width: 100%;
        max-width: 300px;
        height: auto;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        user-select: none;
        border-radius: 0.5rem;
    }

    .synopsis {
        margin-top: 0;
        margin-bottom: 1.5rem;
        line-height: 1.6;
        color: #cdd5e4;
    }

    .info-block {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 1.25rem;
    }

    .info-block p {
        margin: 0;
        line-height: 1.5;
    }

    .info-block strong {
        color: var(--main-color);
    }

    .message {
        color: #b5bdcf;
    }

    .actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .edit {
        text-decoration: none;
        color: #000;
        background: var(--main-color);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        font-weight: 600;
    }

    .delete {
        color: #ff7a7a;
        background: transparent;
        border: 1px solid rgba(255, 122, 122, 0.5);
        border-radius: 4px;
        padding: 0.6rem 1rem;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 120ms ease;
    }

    .delete:hover {
        background: rgba(255, 122, 122, 0.12);
    }

    @media (max-width: 600px) {
        .page {
            padding: 1rem;
        }

        h1 {
            font-size: 1.8rem;
        }

        .movie-details {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .poster {
            display: flex;
            justify-content: center;
        }

        .poster img {
            width: min(75vw, 260px);
            max-width: 260px;
        }
    }
</style>
