---
import { movies } from "@/data/movies";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

export async function getStaticPaths() {
    return movies.map((movie) => ({
        params: { slug: movie.slug },
        props: { movie },
    }));
}

const { movie } = Astro.props;

const formattedDate = new Date(movie.release_date).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{movie.title}</title>
        <ClientRouter />
    </head>
    <body>
        <main>
            <a href="/">← Volver</a>

            <h1>{movie.title}</h1>
            <div class="movie-details">
                <div>
                    <img 
                      src={movie.imageSrc} 
                      alt={`Carátula de ${movie.title}`} 
                      transition:name={`poster-${movie.slug}`} 
                    />
                </div>
                <div>
                    <p class="synopsis">{movie.synopsis}</p>

                    <div class="info-block">
                        <div class="info-title">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21 10H3M16 2V6M8 2V6M7.8 22H16.2C17.8802 22 18.7202 22 19.362 21.673C19.9265 21.3854 20.3854 20.9265 20.673 20.362C21 19.7202 21 18.8802 21 17.2V8.8C21 7.11984 21 6.27976 20.673 5.63803C20.3854 5.07354 19.9265 4.6146 19.362 4.32698C18.7202 4 17.8802 4 16.2 4H7.8C6.11984 4 5.27976 4 4.63803 4.32698C4.07354 4.6146 3.6146 5.07354 3.32698 5.63803C3 6.27976 3 7.11984 3 8.8V17.2C3 18.8802 3 19.7202 3.32698 20.362C3.6146 20.9265 4.07354 21.3854 4.63803 21.673C5.27976 22 6.11984 22 7.8 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <strong>Fecha de estreno</strong>
                        </div>
                        <p>{formattedDate}</p>
                    </div>

                    <div class="info-block">
                        <div class="info-title">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 6V12L16 14M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <strong>Duración</strong>
                        </div>
                        <p>{movie.duration} minutos</p>
                    </div>

                    <div class="info-block">
                        <div class="info-title">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chair-director">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M6 21l12 -9" />
                                <path d="M6 12l12 9" />
                                <path d="M5 12h14" />
                                <path d="M6 3v9" />
                                <path d="M18 3v9" />
                                <path d="M6 8h12" />
                                <path d="M6 5h12" />
                            </svg>
                            <strong>Director</strong>
                        </div>
                        <p>{movie.director}</p>
                    </div>
                </div>    
            </div>
        </main>

        <style>
            main {
                max-width: 800px;
                margin: 0 auto;
                padding: 1rem;
            }

            img {
                max-width: 300px;
                height: auto;
                aspect-ratio: 2/3;
                user-select: none;
            }

            .movie-details { 
                display: grid;
                grid-template-columns: 1fr 2fr;
                gap: 2rem;
            }

            a {
                text-decoration: none;
                background: var(--main-color);
                color: black;
                padding: 0.5rem 1rem;
                border-radius: 4px;
            }

            .synopsis {
                margin-bottom: 1.5rem;
            }

            .info-block {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
                margin-bottom: 1rem;
            }

            .info-block p {
                margin: 0;
            }

            .info-title {
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .info-title svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }
        </style>
    </body>
</html>