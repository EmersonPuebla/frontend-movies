---
import "@/styles/global.css";
import { movies } from "@/data/movies";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Iniciar sesión</title>
  </head>
  <body>
    <main class="login-page">
      <div class="movie-background" aria-hidden="true">
        <div class="movie-track">
          {
            [...movies, ...movies].map((movie) => (
              <img src={movie.imageSrc} alt="" />
            ))
          }
        </div>
      </div>
      <section class="auth-panel" aria-labelledby="auth-title">
        <h1 id="auth-title">Bienvenido</h1>
        <p class="subtitle">Inicia sesión para continuar disfrutando tus películas.</p>

        <form id="login-form" class="auth-form">
          <label for="login-email">Email</label>
          <input id="login-email" name="email" type="email" placeholder="tu@email.com" autocomplete="email" required />

          <label for="login-password">Contraseña</label>
          <input id="login-password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" minlength="8" required />

          <button type="submit">Iniciar sesión</button>
          <p class="form-message" aria-live="polite"></p>
        </form>

        <form id="register-form" class="auth-form is-hidden">
          <label for="register-name">Nombre</label>
          <input id="register-name" name="name" type="text" placeholder="Tu nombre" autocomplete="name" required />

          <label for="register-email">Email</label>
          <input id="register-email" name="email" type="email" placeholder="tu@email.com" autocomplete="email" required />

          <label for="register-password">Contraseña</label>
          <input id="register-password" name="password" type="password" placeholder="Mínimo 8 caracteres" autocomplete="new-password" minlength="8" required />

          <label for="register-confirm-password">Confirmar contraseña</label>
          <input id="register-confirm-password" name="confirm-password" type="password" placeholder="Repite tu contraseña" autocomplete="new-password" minlength="8" required />

          <button type="submit">Crear cuenta</button>
          <p class="form-message" aria-live="polite"></p>
        </form>

        <form id="confirmation-form" class="auth-form is-hidden">
          <label for="confirmation-code-1">Código de confirmación</label>
          <div class="code-inputs" role="group" aria-label="Código de confirmación de 6 dígitos">
            {
              Array.from({ length: 6 }, (_, index) => (
                <input
                  id={`confirmation-code-${index + 1}`}
                  name={`code-${index + 1}`}
                  type="text"
                  inputmode="numeric"
                  autocomplete={index === 0 ? "one-time-code" : "off"}
                  maxlength="1"
                  pattern="[0-9]"
                  aria-label={`Dígito ${index + 1}`}
                  required
                />
              ))
            }
          </div>
          <p class="hint">Introduce el código de 6 dígitos que recibirás por email.</p>
          <button type="submit">Confirmar cuenta</button>
          <p class="form-message" aria-live="polite"></p>
        </form>

        <nav class="auth-links" aria-label="Opciones de cuenta">
          <button type="button" data-view="register">¿No tienes cuenta? Regístrate</button>
          <button type="button" data-view="login" class="is-hidden">Ya tengo una cuenta</button>
          <button type="button" data-view="confirmation">Tengo un código de confirmación</button>
        </nav>
      </section>
    </main>
  </body>
</html>

<style>
  .login-page {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 15% 20%, rgba(89, 255, 194, 0.22), transparent 30%),
      radial-gradient(circle at 85% 80%, rgba(104, 91, 255, 0.28), transparent 35%),
      linear-gradient(135deg, #101827 0%, #090d16 55%, #17112b 100%);
    padding: 2rem;
    box-sizing: border-box;
  }

  .movie-background {
    position: absolute;
    inset: -10%;
    overflow: hidden;
    opacity: 0.16;
    transform: rotate(-8deg) scale(1.15);
    pointer-events: none;
  }

  .movie-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: movie-scroll 32s linear infinite;
  }

  .movie-track img {
    width: clamp(10rem, 18vw, 16rem);
    height: clamp(15rem, 27vw, 24rem);
    flex: 0 0 auto;
    object-fit: cover;
    border-radius: 0.75rem;
    filter: saturate(0.8);
  }

  @keyframes movie-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .login-page::before,
  .login-page::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }

  .login-page::before {
    width: 18rem;
    height: 18rem;
    top: -7rem;
    right: 12%;
    background: rgba(89, 255, 194, 0.08);
    box-shadow: 0 0 100px rgba(89, 255, 194, 0.18);
  }

  .login-page::after {
    width: 24rem;
    height: 24rem;
    bottom: -12rem;
    left: 8%;
    background: rgba(116, 92, 255, 0.1);
    box-shadow: 0 0 120px rgba(116, 92, 255, 0.2);
  }

  form {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .auth-panel {
    position: relative;
    z-index: 1;
    width: min(100%, 25rem);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 2.5rem;
  }

  .subtitle {
    margin: 0.75rem 0 2rem;
    color: #b5bdcf;
  }

  .auth-form {
    display: grid;
    gap: 0.6rem;
    text-align: left;
  }

  label {
    margin-top: 0.4rem;
    color: #e4e9f2;
    font-size: 0.9rem;
    font-weight: 600;
  }

  input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.5rem;
    padding: 0.8rem 0.9rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    font: inherit;
  }

  input:focus {
    border-color: var(--main-color);
    outline: 2px solid rgba(89, 255, 194, 0.25);
  }

  .code-inputs {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.55rem;
  }

  .code-inputs input {
    min-width: 0;
    padding: 0.75rem 0.25rem;
    text-align: center;
    font-size: 1.75rem;
    font-weight: 700;
  }

  button {
    border: 0;
    border-radius: 0.5rem;
    padding: 0.85rem 1.5rem;
    color: #000;
    background-color: var(--main-color);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  button:hover {
    filter: brightness(0.9);
  }

  .auth-form button {
    margin-top: 1rem;
  }

  .auth-links {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.5rem;
  }

  .auth-links button {
    padding: 0.35rem;
    color: var(--main-color);
    background: transparent;
    font-size: 0.85rem;
    font-weight: 400;
  }

  .auth-links button:hover {
    text-decoration: underline;
  }

  .hint,
  .form-message {
    margin: 0.25rem 0 0;
    color: #b5bdcf;
    font-size: 0.8rem;
  }

  .is-hidden {
    display: none;
  }

  :global(body) {
    margin: 0;
  }
</style>

<script>
  const forms = {
    login: document.querySelector<HTMLFormElement>("#login-form"),
    register: document.querySelector<HTMLFormElement>("#register-form"),
    confirmation: document.querySelector<HTMLFormElement>("#confirmation-form"),
  };
  const viewButtons = document.querySelectorAll<HTMLButtonElement>("[data-view]");

  const showView = (view: keyof typeof forms) => {
    Object.entries(forms).forEach(([name, form]) => {
      form?.classList.toggle("is-hidden", name !== view);
    });
    viewButtons.forEach((button) => {
      button.classList.toggle("is-hidden", button.dataset.view === view);
    });
  };

  viewButtons.forEach((button) => {
    button.addEventListener("click", () => showView(button.dataset.view as keyof typeof forms));
  });

  forms.register?.addEventListener("submit", (event) => {
    event.preventDefault();
    const password = forms.register?.elements.namedItem("password") as HTMLInputElement;
    const confirmation = forms.register?.elements.namedItem("confirm-password") as HTMLInputElement;

    if (password.value !== confirmation.value) {
      confirmation.setCustomValidity("Las contraseñas no coinciden.");
      confirmation.reportValidity();
      return;
    }

    confirmation.setCustomValidity("");
    showView("confirmation");
  });

  forms.confirmation?.addEventListener("submit", (event) => {
    event.preventDefault();
    const message = forms.confirmation?.querySelector(".form-message");
    if (message) message.textContent = "La confirmación se conectará cuando el backend esté disponible.";
  });

  const codeInputs = Array.from(document.querySelectorAll<HTMLInputElement>(".code-inputs input"));
  codeInputs.forEach((input, index) => {
    input.addEventListener("input", () => {
      input.value = input.value.replace(/\D/g, "").slice(-1);
      if (input.value && codeInputs[index + 1]) codeInputs[index + 1].focus();
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Backspace" && !input.value && codeInputs[index - 1]) {
        codeInputs[index - 1].focus();
      }
    });

    input.addEventListener("paste", (event) => {
      event.preventDefault();
      const pastedCode = event.clipboardData?.getData("text").replace(/\D/g, "").slice(0, 6) ?? "";
      pastedCode.split("").forEach((digit, digitIndex) => {
        if (codeInputs[digitIndex]) codeInputs[digitIndex].value = digit;
      });
      codeInputs[Math.min(pastedCode.length, 5)]?.focus();
    });
  });
</script>
